#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define HOTKEY  3

#define AS(keycode) &as LS(keycode) keycode

&mt {
    tapping-term-ms = <100>; // This is the value already set by default
};

/ {
    macros {
        macro_email_q: macro_email_q {
            // 714448168@qq.com

            label = "MACRO_EMAIL_QQ";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N1 &kp N4 &kp N4 &kp N4 &kp N8 &kp N1 &kp N6 &kp N8 &kp AT &kp Q &kp Q &kp DOT &kp C &kp O &kp M>;
        };

        GUANJIANCI: GUANJIANCI {
            compatible = "zmk,behavior-macro";
            label = "new_macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp LBKT &kp RBKT &kp LEFT &kp LSHIFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lup {
            bindings = <&kp UP>;
            key-positions = <15 16>;
            layers = <0 1>;
            timeout-ms = <50>;
        };

        ldown {
            bindings = <&kp DOWN>;
            key-positions = <39 40>;
            timeout-ms = <50>;
        };

        lleft {
            bindings = <&kp LEFT>;
            key-positions = <26 27>;
            layers = <0 1>;
            timeout-ms = <50>;
        };

        lright {
            bindings = <&kp RIGHT>;
            key-positions = <27 28>;
            layers = <0 1>;
            timeout-ms = <50>;
        };

        rup {
            bindings = <&kp UP>;
            key-positions = <19 20>;
            layers = <0 1>;
            timeout-ms = <50>;
        };

        rdown {
            bindings = <&kp DOWN>;
            key-positions = <43 44>;
            timeout-ms = <50>;
        };

        rleft {
            bindings = <&kp LEFT>;
            key-positions = <31 32>;
            layers = <0 1>;
            timeout-ms = <50>;
        };

        rright {
            bindings = <&kp RIGHT>;
            key-positions = <32 33>;
            layers = <0 1>;
            timeout-ms = <50>;
        };

        CTRLF9 {
            bindings = <&kp LC(F9)>;
            layers = <0 1>;
            key-positions = <49 50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp ESCAPE    &kp N1            &kp N2       &kp N3       &kp N4          &kp N5       &kp N6       &kp N7         &kp N8               &kp N9           &kp N0                  &kp DELETE
&kp TAB       &mt LS(Q) Q       &mt LS(W) W  &mt LS(E) E  &mt LS(R) R     &mt LS(T) T  &mt LS(Y) Y  &mt LS(U) U    &mt LS(I) I          &mt LS(O) O      &mt LS(P) P             &mt LS(EQUAL) EQUAL
&kp CAPSLOCK  &mt LS(A) A       &mt LS(S) S  &mt LS(D) D  &mt LS(F) F     &mt LS(G) G  &mt LS(H) H  &mt LS(J) J    &mt LS(K) K          &mt LS(L) L      &mt LS(SEMI) SEMICOLON  &mt LS(SQT) SQT
&kp LSHFT     &mt LS(Z) Z       &mt LS(X) X  &mt LS(C) C  &mt LS(V) V     &mt LS(B) B  &mt LS(N) N  &mt LS(M) M    &mt LS(COMMA) COMMA  &mt LS(DOT) DOT  &mt LS(FSLH) SLASH      &mt LS(MINUS) MINUS
              &kp LEFT_CONTROL  &mkp RCLK    &mkp LCLK    &mt LGUI ENTER  &mo 1                     &kp BACKSPACE  &mo 2                &kp SPACE
            >;
        };

        number_layer {
            label = "NUMBER";
            bindings = <
&kp F12         &kp F1        &kp F2          &kp F3    &kp F4     &kp F5                       &kp F6                         &kp F7     &kp F8     &kp F9     &kp F10                        &kp F11
&kp C_VOL_DN    &kp C_VOL_UP  &none           &kp UP    &none      &mt LEFT_BRACE LEFT_BRACKET  &mt RIGHT_BRACE RIGHT_BRACKET  &kp KP_N7  &kp KP_N8  &kp KP_N9  &mt KP_SUBTRACT KP_PLUS        &none
&none           &none         &kp LEFT        &kp DOWN  &kp RIGHT  &mt LESS_THAN COMMA          &mt GREATER_THAN PERIOD        &kp KP_N4  &kp KP_N5  &kp KP_N6  &mt RS(KP_DIVIDE) KP_MULTIPLY  &none
&macro_email_q  &GUANJIANCI   &macro_email_q  &none     &none      &mt PLUS EQUAL               &mt UNDERSCORE MINUS           &kp KP_N1  &kp KP_N2  &kp KP_N3  &none                          &none
                &none         &none           &none     &none      &none                                                       &none      &none      &kp KP_N0
            >;
        };

        symbol_layer {
            label = "SYMBOL";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&sys_reset    &none         &none         &none         &none         &out OUT_USB  &out OUT_USB  &none         &none         &none         &none         &sys_reset
&none         &none         &none         &none         &none         &out OUT_BLE  &out OUT_BLE  &none         &none         &none         &none         &none
&none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
              &none         &none         &none         &none         &none                       &none         &none         &none
            >;
        };

        hotkey_layer {
            label = "HOTKEY";
            bindings = <
&none  &none           &kp F10  &kp F11  &kp F12  &none  &none  &none  &none  &none  &none  &none
&none  &macro_email_q  &kp F7   &kp F8   &kp F9   &none  &none  &none  &none  &none  &none  &none
&none  &none           &kp F4   &kp F5   &kp F6   &none  &none  &none  &none  &none  &none  &none
&none  &none           &kp F1   &kp F2   &kp F3   &none  &none  &none  &none  &none  &none  &none
       &none           &none    &none    &none    &none         &none  &none  &none
            >;
        };
    };
};
